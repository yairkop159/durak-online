// Phase 10: device profiles, match history and ELO ratings.
// The connection URL lives in prisma.config.ts (Prisma 7); the server connects through
// @prisma/adapter-pg (src/db/database.ts).

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

/// A password-free device profile. Only the SHA-256 of the secret device key is stored.
model Profile {
  id                String    @id
  nickname          String
  deviceKeyHash     String    @unique @map("device_key_hash")
  /// SHA-256 of the one-time transfer code (null when none is open).
  transferCodeHash  String?   @unique @map("transfer_code_hash")
  transferExpiresAt DateTime? @map("transfer_expires_at")
  rating            Int       @default(1000)
  /// Every stored game with this profile, rated or not.
  games             Int       @default(0)
  ratedGames        Int       @default(0) @map("rated_games")
  wins              Int       @default(0)
  duraks            Int       @default(0)
  forfeits          Int       @default(0)
  /// Tournaments this profile won (co-champions each count one; never for a bot champion).
  tournamentsWon    Int       @default(0) @map("tournaments_won")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  seats             GamePlayer[]
  tournamentSeats   TournamentPlayer[]

  @@index([rating(sort: Desc), id], map: "profiles_leaderboard_idx")
  @@map("profiles")
}

/// A finished game with at least one profiled human (id = the server's gameId).
model Game {
  id             String   @id
  roomId         String   @map("room_id")
  mode           String
  /// A 2v2 team game (seats 0+2 vs 1+3).
  teams          Boolean  @default(false)
  playerCount    Int      @map("player_count")
  /// normal | forfeit | abandoned | restarted
  endReason      String   @map("end_reason")
  rated          Boolean
  /// A bot played for at least one human (AFK or leave takeover).
  botAssisted    Boolean  @map("bot_assisted")
  durakProfileId String?  @map("durak_profile_id")
  startedAt      DateTime @map("started_at")
  endedAt        DateTime @map("ended_at")

  players GamePlayer[]

  @@index([endedAt])
  @@map("games")
}

enum PlayerResult {
  win
  durak
  draw
  forfeit
  unfinished
  /// Team mode: the durak's partner (the team lost).
  teamLoss

  @@map("player_result")
}

/// One seat of a stored game. Bots and humans without a profile have no profile_id.
model GamePlayer {
  gameId       String       @map("game_id")
  seat         Int
  profileId    String?      @map("profile_id")
  nickname     String
  isBot        Boolean      @map("is_bot")
  result       PlayerResult
  ratingBefore Int?         @map("rating_before")
  ratingAfter  Int?         @map("rating_after")
  forfeited    Boolean
  botAssisted  Boolean      @map("bot_assisted")

  game    Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  profile Profile? @relation(fields: [profileId], references: [id], onDelete: SetNull)

  @@id([gameId, seat])
  @@index([profileId, gameId])
  @@map("game_players")
}

/// A finished or early-ended tournament (a series of games in one room) with at least one
/// profiled human. id = the server's tournament id.
model Tournament {
  id           String   @id
  roomId       String   @map("room_id")
  mode         String
  teams        Boolean
  gamesPlanned Int      @map("games_planned")
  gamesPlayed  Int      @map("games_played")
  /// finished | endedEarly (an early end has no champion)
  status       String
  startedAt    DateTime @map("started_at")
  endedAt      DateTime @map("ended_at")

  players TournamentPlayer[]

  @@index([endedAt])
  @@map("tournaments")
}

/// One roster seat of a stored tournament. Bots and unprofiled humans have no profile_id.
model TournamentPlayer {
  tournamentId String   @map("tournament_id")
  seat         Int
  profileId    String?  @map("profile_id")
  nickname     String
  isBot        Boolean  @map("is_bot")
  /// The human left during the series (a bot played the seat; never champion).
  left         Boolean
  /// Points of the seat (classic) or of its team (2v2); multiples of 0.5.
  points       Float
  duraks       Int
  rank         Int
  champion     Boolean

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  profile    Profile?   @relation(fields: [profileId], references: [id], onDelete: SetNull)

  @@id([tournamentId, seat])
  @@index([profileId])
  @@map("tournament_players")
}
