{
  "name": "@durak/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "typecheck": "prisma generate && tsc -p tsconfig.json",
    "dev": "prisma generate && tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "prisma generate && vitest run",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "generate": "prisma generate"
  },
  "dependencies": {
    "@durak/game-engine": "0.1.0",
    "@durak/shared": "0.1.0",
    "@fastify/static": "^8.3.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "fastify": "^5.2.0",
    "ioredis": "^5.11.1",
    "pg": "8.23.1",
    "prisma": "7.10.1",
    "socket.io": "^4.8.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "socket.io-client": "^4.8.1",
    "tsx": "^4.19.0"
  }
}
