POSTGRES_USER=durak
POSTGRES_PASSWORD=durak
POSTGRES_DB=durak
DATABASE_URL=postgresql://durak:durak@localhost:5432/durak
REDIS_URL=redis://localhost:6379

# Server
PORT=3000
HOST=0.0.0.0
# Comma-separated list of allowed browser origins for Socket.io
CORS_ORIGINS=http://localhost:5173
# Storage backend: memory | redis (default: redis when REDIS_URL is set, else memory)
REPOSITORY=redis
# Key prefix for every Redis key (tests use a random one)
REDIS_PREFIX=durak:
# Turn timers (ms)
TURN_TIMEOUT_MS=30000
AFK_TIMEOUT_MS=5000
RECONNECT_GRACE_MS=60000
