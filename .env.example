POSTGRES_USER=durak
POSTGRES_PASSWORD=durak
POSTGRES_DB=durak
DATABASE_URL=postgresql://durak:durak@localhost:5432/durak
REDIS_URL=redis://localhost:6379

# Server
PORT=3000
HOST=0.0.0.0
# NODE_ENV=production: same-origin only by default (the server serves the web client itself)
# NODE_ENV=production
# Extra browser origins allowed to connect (comma-separated, no "*"); the server's own origin is
# always allowed. Default: http://localhost:5173 in development, none in production.
CORS_ORIGINS=http://localhost:5173
# Reverse proxies in front of the server (X-Forwarded-For hops to trust): 0/false, 1 on Fly/Render/Railway
# and behind a Cloudflare Quick Tunnel (`npm run tunnel` sets it)
TRUST_PROXY=0
# Built web client to serve (default: apps/web/dist next to the server, when it exists)
# WEB_DIST_DIR=
# Storage backend: memory | redis (default: redis when REDIS_URL is set, else memory)
REPOSITORY=redis
# Key prefix for every Redis key (tests use a random one)
REDIS_PREFIX=durak:
# Turn timers (ms)
TURN_TIMEOUT_MS=30000
AFK_TIMEOUT_MS=5000
RECONNECT_GRACE_MS=60000

# Bot worker threads (default: usable CPUs - 1, between 1 and 4; cgroup-aware)
# BOT_WORKERS=1
BOT_JOB_TIMEOUT_MS=2000

# Abuse limits (per process; the server runs as ONE instance)
RATE_LIMIT_BURST=20
RATE_LIMIT_PER_SEC=10
RATE_LIMIT_DISCONNECT_AFTER=100
MAX_ROOMS_PER_IP_PER_HOUR=30
MAX_ROOMS=500
MAX_SOCKETS_PER_IP=20
