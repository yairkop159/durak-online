{
  "name": "durak-online",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/shared",
    "packages/game-engine",
    "apps/server",
    "apps/web"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build --workspaces",
    "test": "npm test --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "clean": "npm run clean --workspaces",
    "dev": "npm run build --workspace=packages/shared --workspace=packages/game-engine && concurrently -k -n server,web -c blue,green \"npm run dev --workspace=apps/server\" \"npm run dev --workspace=apps/web\""
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0",
    "concurrently": "^9.1.0"
  }
}
